# ====================================
# Android .gitignore - Labasni
# ====================================

# Built application files
*.apk
*.ap_
*.aab
*.apks
*.aar

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Kotlin
*.kt.swp
*.kt.bak
*.ktc

# Generated files
bin/
gen/
out/
release/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Gradle files
.gradle/
.gradle
.gradle/**
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Fichiers Gradle générés
*.bin
*.lock
**/.gradle/**/*.bin
**/.gradle/**/*.lock
**/build/**/*.bin
**/build/**/*.lock
**/build/**/*.properties

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log
logs/

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA / Android Studio
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/jarRepositories.xml
.idea/caches
.idea/modules.xml
.idea/.name
.idea/compiler.xml
.idea/misc.xml
.idea/vcs.xml
.idea/shelf/
.idea/navEditor.xml
*.iws
*.ipr

# Keystore files
*.jks
*.keystore
*.key

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json
google-services.json.bak

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
*.lint

# Android Profiling
*.hprof

# NDK
obj/
.externalNativeBuild/

# Signing files
signing.properties
keystore.properties

# Bundle files
*.bundle

# Firebase
crashlytics.properties
crashlytics-build.properties
fabric.properties

# ProGuard
proguard-rules.pro.bak

# Testing
**/src/androidTest/res/
**/src/test/res/

# Coverage
coverage/
*.coverage
.nyc_output/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*

# ====================================
# Fichiers générés par Gradle/Build
# ====================================

# Fichiers JSON générés (métadonnées, configurations de build, etc.)
**/build/**/*.json
**/intermediates/**/*.json
**/outputs/**/*.json
**/generated/**/*.json
*.metadata.json
*.output-metadata.json

# Fichiers DEX générés
**/build/**/*.dex
**/intermediates/**/*.dex
**/outputs/**/*.dex

# Fichiers de classe compilés
**/build/**/*.class
**/intermediates/**/*.class

# Fichiers JAR générés
**/build/**/*.jar
**/intermediates/**/*.jar
**/outputs/**/*.jar

# Fichiers .len et .tab (fichiers générés par certains outils)
*.len
*.tab
**/build/**/*.len
**/build/**/*.tab

# Fichiers temporaires de compilation
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.#*
*.orig
*.rej

# ====================================
# OS-specific files
# ====================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ====================================
# IDE specific
# ====================================

# VS Code
.vscode/
*.code-workspace

# Eclipse
.classpath
.project
.settings/
.loadpath
.recommenders

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ====================================
# Android Studio specific
# ====================================

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android Studio 3+
.idea/caches
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/shelf/

# ====================================
# Exceptions (fichiers à garder)
# ====================================

# Garder les fichiers JSON de configuration source (pas les générés)
!**/src/**/*.json
!gradle/**/*.json
!*.gradle.kts
!settings.gradle.kts
!build.gradle.kts
*.xml
*.xml
*.flat
*.flat
*.dex
